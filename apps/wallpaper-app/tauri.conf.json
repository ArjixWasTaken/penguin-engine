{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wallpaper Engine",
  "identifier": "com.github.arjix.wallpaper-engine-rs",
  "version": "0.1.0",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wallpaper Engine",
        "width": 1400,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: thumb: preview: http://thumb.localhost http://preview.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
