{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Penguin Engine",
  "identifier": "com.github.arjixwastaken.penguin-engine",
  "version": "0.1.0",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Penguin Engine",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: thumb: preview: http://thumb.localhost http://preview.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.png"
    ]
  }
}
